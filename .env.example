# Live search. Without both of these the product uses fixture data and says
# so on every screen; there is no half-configured state (see
# apps/website/src/server/search.ts).
#
# Google Programmable Search gives 100 queries a day free, with no card.
# An audit spends one query per search term, which is two or three.
#
#   1. https://programmablesearchengine.google.com/controlpanel/create
#      Create an engine, turn on "Search the entire web", copy the
#      Search engine ID.
#   2. https://developers.google.com/custom-search/v1/introduction
#      Click "Get a Key", pick or create a project, copy the key.
#
# Keep this file out of git. Secrets are server-side only and must never
# reach a client bundle (rule 18).
REP_SEARCH_API_KEY=
REP_SEARCH_ENGINE_ID=

# Results per query term. 10 is the API maximum for one call.
REP_SEARCH_PER_QUERY=10

# The site stays out of search indexes unless this is exactly "true".
REP_INDEXABLE=false
